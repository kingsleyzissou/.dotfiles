{
  "mcpServers": {
    "ctx7": {
      "url": "https://mcp.context7.com/mcp",
      "enabled": true,
      "headers": {
        "CONTEXT7_API_KEY": "${CTX7_TOKEN}"
      }
    },
    "codegraph": {
      "command": "bunx",
      "args": [
        "-y",
        "@colbymchenry/codegraph",
        "serve",
        "--mcp"
      ],
      "exposure": "direct"
    },
    "memory": {
      "command": "bunx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-memory"
      ],
      "env": {
        "MEMORY_FILE_PATH": "${MEMORY_FILE_PATH}"
      }
    },
    "jira": {
      "url": "https://mcp.atlassian.com/v1/mcp",
      "exposure": "direct",
      "enabled": false
    }
  }
}
