# ==============================================================================
# WORKSPACES (AeroSpace: 9 Workspaces, Fixed)
# ==============================================================================
[org/gnome/mutter]
dynamic-workspaces=false

[org/gnome/desktop/wm/preferences]
num-workspaces=9

# ==============================================================================
# WINDOW & WORKSPACE NAVIGATION
# ==============================================================================
[org/gnome/desktop/wm/keybindings]
# Fullscreen (alt-f, alt-shift-f)
toggle-fullscreen=['<Alt>f', '<Alt><Shift>f']

# Workspace Switching (alt-1 through alt-9)
switch-to-workspace-1=['<Alt>1']
switch-to-workspace-2=['<Alt>2']
switch-to-workspace-3=['<Alt>3']
switch-to-workspace-4=['<Alt>4']
switch-to-workspace-5=['<Alt>5']
switch-to-workspace-6=['<Alt>6']
switch-to-workspace-7=['<Alt>7']
switch-to-workspace-8=['<Alt>8']
switch-to-workspace-9=['<Alt>9']

# Move Window to Workspace (alt-shift-1 through alt-shift-9)
move-to-workspace-1=['<Alt><Shift>1']
move-to-workspace-2=['<Alt><Shift>2']
move-to-workspace-3=['<Alt><Shift>3']
move-to-workspace-4=['<Alt><Shift>4']
move-to-workspace-5=['<Alt><Shift>5']
move-to-workspace-6=['<Alt><Shift>6']
move-to-workspace-7=['<Alt><Shift>7']
move-to-workspace-8=['<Alt><Shift>8']
move-to-workspace-9=['<Alt><Shift>9']

# Move Window to Next Monitor (alt-shift-tab)
move-to-monitor-right=['<Alt><Shift>Tab']

# Directional Window Snapping (alt-left, alt-right, alt-up, alt-down)
# Vanilla GNOME floating has no directional focus; this snaps half-screen / maximizes
[org/gnome/mutter/keybindings]
toggle-tiled-left=['<Super>Left']
toggle-tiled-right=['<Super>Right']

[org/gnome/desktop/wm/keybindings]
close=['<Alt>q', '<Super>q']

# ==============================================================================
# SYSTEM CONTROLS
# ==============================================================================
# Mission Control / Overview (alt-m)
[org/gnome/shell/keybindings]
toggle-overview=['<Alt>m', '<Super>']

# Lock Screen (alt-esc)
[org/gnome/settings-daemon/plugins/media-keys]
screensaver=['<Alt>Escape', '<Super>l']

# ==============================================================================
# APPLICATION LAUNCHERS (User & System Apps)
# ==============================================================================
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ghostty/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/obsidian/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/slack/', '/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/files/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/ghostty]
name='Ghostty'
command='ghostty'
binding='<Alt>Return'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/obsidian]
name='Obsidian'
command='obsidian'
binding='<Alt>n'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/slack]
name='Slack'
command='slack'
binding='<Alt>s'

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/files]
name='Finder / Files'
command='nautilus --new-window'
binding='<Alt>b'

# ==============================================================================
# WINDOW RULES (Assign apps to workspaces)
# Requires official Fedora package: gnome-shell-extension-auto-move-windows
# ==============================================================================
[org/gnome/shell/extensions/auto-move-windows]
application-list=['com.mitchellh.ghostty.desktop:2', 'md.obsidian.Obsidian.desktop:3', 'com.slack.Slack.desktop:4', 'org.gnome.Evolution.desktop:5', '1password.desktop:9']
