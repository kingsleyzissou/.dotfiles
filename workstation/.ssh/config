Host *
  SendEnv LANG LC_*
  ForwardX11 no
  ForwardAgent yes
  ServerAliveInterval 15
  ConnectTimeout 20
  AddKeysToAgent yes

# GitLab.com
Host gitlab.com
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/gzuccare

# Private GitLab instance
Host gitlab.cee.redhat.com
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/gzuccare

Host github.com
  User git
  Hostname ssh.github.com
  PreferredAuthentications publickey
  IdentityFile ~/.ssh/kingsley
  IdentityFile ~/.ssh/gzuccare

# VM
Host localvm
  User kingsley
  Hostname localhost
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
  IdentityFile ~/.ssh/kingsley
  IdentityFile ~/.ssh/gzuccare
  Port 2222
  ForwardAgent yes
  RemoteForward 5556 localhost:5556

Host linux
  User kingsley
  Hostname zissou
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

Host mac
  User zissou
  Hostname mac-mini
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null

Host raspi
  User kingsley
  Hostname raspi
  StrictHostKeyChecking no
  UserKnownHostsFile /dev/null
